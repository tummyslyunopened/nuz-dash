#!/bin/sh
# Auto-deploy the onboarding site when pushed commits touch site/.
# Never blocks the push: deploy failures only print a warning.

deploy_needed=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -q '^site/'; then
    deploy_needed=1
  fi
done

if [ "$deploy_needed" = "1" ]; then
  echo "[nuz-dash] site/ changed in this push - deploying onboarding site to Cloudflare Pages..."
  if node scripts/deploy-site.mjs; then
    echo "[nuz-dash] site deployed."
  else
    echo "[nuz-dash] WARNING: site deploy failed - push continues. Run 'npm run site:deploy' manually."
  fi
fi

exit 0
